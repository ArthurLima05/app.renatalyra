# Ambiente de DEMONSTRAÇÃO — nunca aponta para o Supabase de produção.
# VITE_DEMO_MODE=true faz o app inteiro usar dados fictícios em memória
# (ver src/data/demoSeed.ts); nenhuma chamada de rede ao Supabase é feita.
# As credenciais abaixo são placeholders inválidos, mantidos apenas para o
# SDK do Supabase poder ser instanciado sem erro — eles nunca são usados de fato.
VITE_DEMO_MODE=true
VITE_SUPABASE_PROJECT_ID=demo-placeholder
VITE_SUPABASE_PUBLISHABLE_KEY=demo-placeholder-key
VITE_SUPABASE_URL=https://demo-placeholder.supabase.co

# Webhooks do n8n — não utilizados em modo demo (todas as integrações de
# WhatsApp são simuladas em memória, ver src/contexts/*.demo.tsx)
VITE_N8N_RETURN_ALERT_WEBHOOK_URL=
VITE_N8N_FEEDBACK_WEBHOOK_URL=
VITE_N8N_CANCELAMENTO_WEBHOOK_URL=
